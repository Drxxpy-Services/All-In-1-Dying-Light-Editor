mov rsi,AIMeshName
mov rdi,[AIMeshName_allocation]
rep movsb

mov rcx,[AIMeshName_allocation]
movsxd rax,dword ptr [AIMeshLength]
mov byte ptr [rcx+rax],0 //Prevents crash from game not recognizing mesh name
mov [rdx-10],rcx

pops:
pop rdi
pop rsi

