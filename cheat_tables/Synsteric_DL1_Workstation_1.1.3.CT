alloc(stringCAI_length,4)
label(code)
label(return)
label(calculate_length)
label(end_length)
label(after_length_calculation)

iterationCraftAnyItem:
dd 0
//rbx == string length + 1
//rsi == string length

newmem:
push rcx
push rax
//push rsi
pushfq

cmp [desCAIString],0
je code

cmp dword ptr [iterationCraftAnyItem],99
jae code

mov rcx,rdi
sub rcx,rsp
cmp rcx,5000
jle code

mov rax,rdi
shr rax,#36
cmp eax,7FF
je code


mov rax,[rsp+90]
mov ax,[rax+26]
cmp ax,FAC1
jne code
/*
mov rax,[rsp+90]
mov ax,[rax+16]
cmp ax,92FF
jne code
*/
lea rcx,[desCAIString]
xor rsi,rsi
xor rax,rax
jmp calculate_length

after_length_calculation:
cmp [stringCAI_length],5
jle code

mov rbx,[stringCAI_length]
lea rdi,[desCAIString]
mov [myCraftPlanClass],rdi
lea rdi,[myCraftPlanClass]

inc dword ptr [iterationCraftAnyItem]
code:
popfq
//pop rsi
pop rax
pop rcx
  mov rdx,[rdi]
  mov r8d,ebx
  jmp return

calculate_length:
    mov al, [rcx]
    cmp al, 0
    je end_length
    inc rcx
    inc rsi
    jmp calculate_length

end_length:
inc esi
mov [stringCAI_length],esi
dec esi
jmp after_length_calculation

CraftAnyItem:
  jmp newmem
  nop
return:
registersymbol(CraftAnyItem)

