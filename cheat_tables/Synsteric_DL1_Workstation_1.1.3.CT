aobscanmodule(TPToMap,gamedll_x64_rwdi.dll,49 8B 14 24 4C 8B C3 48 89 45)
alloc(newmem,$512,TPToMap)
alloc(Mapstring,$32)
registersymbol(Mapstring)
label(code)
label(return)
Mapstring:
db 'slums',0



alloc(iterationTPToMap,4)
iterationTPToMap:
dd 0
alloc(stringTPToMap_length,4)

// rdi == string length
// rbx == string length+1

newmem:
cmp [Mapstring],0
je code
push rax
push rcx
push rdx
push r8
push r9
push r11

lea rcx,[Mapstring]
call ucrtbase.strlen
mov [stringTPToMap_length],eax

pop r11
pop r9
pop r8
pop rdx
pop rcx
pop rax

cmp [stringTPToMap_length],3
jle code

lea rdx,[Mapstring]
movzx ebx,[stringTPToMap_length]
add ebx,2 //whatever

  //mov [r12+8],ebx //this is for quest (some random shit)
  //mov [r12+C],ebx

  //mov [r13+10],rdx //save specific things (causes crash)
  //mov [r13+18],ebx
  //mov [r13+1C],ebx

  //mov [r11+90],rdx //save specific things (causes crash)
  //mov [r11+98],ebx
  //mov [r11+9C],ebx

//[rbp] - map name 1

  mov [rbp-4],ebx
  mov [rbp-8],ebx

//[rbp-10] - map name 2

  mov [rbp-14],ebx
  mov [rbp-18],ebx

//[rsp+30] - map name 3
  mov [rsp+30],rdx


  //mov [rbp+60],ebx //save specific things
  //mov [rbp+6C],ebx
  //mov [rbp+70],ebx

 mov r8,rbx
 mov rsi,rbx
  jmp return

code:
//[r12] - quest map (random shit)
//r8 - map length
//rsi - map length

  mov rdx,[r12]
  mov r8,rbx
  jmp return



TPToMap:
  jmp newmem
  nop 2
return:
registersymbol(TPToMap)

