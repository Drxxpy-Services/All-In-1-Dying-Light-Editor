aobscanmodule(GetHUDDIManager,gamedll_x64_rwdi.dll,48 85 C9 74 ?? 48 8B 01 FF 90 ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 8B C8 E8 ?? ?? ?? ?? 48 8B 9F)
aobscanmodule(GetHUDDIManagerJE,gamedll_x64_rwdi.dll,74 ?? 48 8B 01 FF 90 ?? ?? ?? ?? E8 ?? ?? ?? ?? 48 8B C8 E8 ?? ?? ?? ?? 48 8B 9F)
alloc(newmem,$128,GetHUDDIManager)
alloc(HUDDIManager,8)
registersymbol(HUDDIManager)
registersymbol(GetHUDDIManager)
label(code)
label(return)

newmem:
test rcx,rcx
je code //jumps if rcx is 0
cmp rcx,[HUDDIManager]
je code
mov [HUDDIManager],rcx
code:
//test rcx,rcx
//je 0x09
reassemble(GetHUDDIManager)
reassemble(GetHUDDIManagerJE)
  jmp return

GetHUDDIManager:
  jmp newmem
return:

aobscanmodule(GetGameDI,gamedll_x64_rwdi.dll,48 8B 41 ?? 48 89 AC 24 ?? ?? ?? ?? 48 8B E9)
alloc(newmem3,$128,GetGameDI)
alloc(GameDI,8)
registersymbol(GameDI)
label(code3)
label(return3)

newmem3:

mov rax,rcx
sub rax,10
test rax,rax
je code3

cmp rax,[GameDI]
je code3
mov [GameDI],rax

code3:
  mov rax,[rcx-10]
  mov [rsp+00000088],rbp
  jmp return3

GetGameDI:
  jmp newmem3
  nop 7
return3:
registersymbol(GetGameDI)

