              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
GetClass()

 local buggy = getAddressList().getMemoryRecordByDescription("Buggy Editor/Viewer")
    if buggy.Active == false then
        buggy.Active = true
        Sleep(1500)
    end


  if not syntaxcheck then
   synchronize(createTimer,300,memrec.setActive,false,activateScriptTemporarily("No Fall Damage", 3000, 1))
  end

{$asm}
aobscanmodule(TeleportToBuggy,engine_x64_rwdi.dll,F3 0F 11 8B C0 00 00 00 F3 0F 11 83 ?? ?? ?? ?? F3 0F 11 93 ?? ?? ?? ?? E8)
alloc(newmem,$256,TeleportToBuggy)
alloc(maxYDeviation,4)
maxYDeviation:
dd (float)0
alloc(YAddition,4)
YAddition:
dd (float)3
label(YMovss)

label(code)
label(return)

newmem:
push rdx
mov rdx,[CarBuggy]
test rdx,rdx
je code
cmp [rbx+48],(float)80
jne code

mov rdx,[rdx+3340]
add rdx,7c
test rdx,rdx
je code

movss xmm0,[rdx] //X
add rdx,8
movss xmm2,[rdx] //Z
sub rdx,4

movss xmm10,[rdx]
subss xmm10,xmm1
//ucomiss xmm10,[maxYDeviation]
//jg code




movss xmm10,[rdx]
addss xmm10,[YAddition]
movss [rdx],xmm10
YMovss:
movss xmm1,[rdx] //Y
jmp code


code:
  movss [rbx+000000C0],xmm1
pop rdx
  jmp return

TeleportToBuggy:
  jmp newmem
  nop 3
return:
registersymbol(TeleportToBuggy)


[DISABLE]
//engine_x64_rwdi.dll+3876E5



TeleportToBuggy:
  db F3 0F 11 8B C0 00 00 00


