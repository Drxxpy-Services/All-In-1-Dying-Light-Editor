{$lua}
--Disables script after execution
if syntaxcheck then return end
local function autoDisableGetClass()


    sleep(100)

local TPTW = getAddressList().getMemoryRecordByDescription("Enable Classes (enable once, no need to enable if classes are already valid)")
    if TPTW then
        TPTW.Active = false
    end

end



createThread(autoDisableGetClass)
