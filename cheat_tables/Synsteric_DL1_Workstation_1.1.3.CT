aobscanmodule(EditTime,gamedll_x64_rwdi.dll,F3 0F 11 8E ?? ?? ?? ?? EB ?? F3 0F 10 8E ?? ?? ?? ?? 33 ED)
alloc(newmem,$1000,EditTime)
alloc(Time,4)
registersymbol(Time)



alloc(op,4)
op:
dd (float)24
registersymbol(op)


label(code)
label(return)

registersymbol(code)


alloc(Time_last,4)
alloc(Time_initialized,1)

label(Time_init)
label(Time_userChanged)
label(Time_gameChanged)
label(Time_endSync)
label(Time_afterSync)

newmem:
//XMM1 - Time

movss xmm10,xmm1 //original value
mulss xmm10,[op] //xmm10 = gameHours


movss xmm11,[Time]
movss xmm12,[Time_last]

ucomiss xmm11,xmm11
jp Time_init

//INIT
cmp byte ptr [Time_initialized],1
jne Time_init

//User
ucomiss xmm11,xmm12
jne Time_userChanged

//Game
ucomiss xmm10,xmm12
jne Time_gameChanged
jmp Time_endSync

Time_init:
movss [Time],xmm10
movss [Time_last],xmm10
mov byte ptr [Time_initialized],1
jmp Time_endSync

Time_userChanged:
movss xmm1,xmm11 //Operation
divss xmm1,[op] //go back to 0.0-1.0
movss [Time_last],xmm11
jmp Time_afterSync

Time_gameChanged:
movss [Time],xmm10
movss [Time_last],xmm10
jmp Time_endSync

Time_endSync:
//Operation to do when user hasn't changed

Time_afterSync:
//Operation to do after user has changed

movsd xmm12,[gamedll_x64_rwdi.dll+1c]
movsd xmm11,[gamedll_x64_rwdi.dll+1c]
movsd xmm10,[gamedll_x64_rwdi.dll+1c]
movsd xmm9,[gamedll_x64_rwdi.dll+1c]





code:
  movss [rsi+000000A4],xmm1
  jmp return

EditTime:
  jmp newmem
  nop 3
return:
registersymbol(EditTime)

[DISABLE]

EditTime:
  db F3 0F 11 8E A4 00 00 00

unregistersymbol(*)  
dealloc(*)  


