    push rbx                 // Save RBX since we use it later
    push rdi                 // Save RDI since we use it later
                             // Load parameters from RCX and RDX
    mov rbx, rcx             // RBX = module base address
    mov rdi, rdx             // RDI = Class Vtable Register address
                             // Subtract 8 from the Class Vtable Register address
    sub rdi,8                // RDI = RDI - 8
                             // Dereference the adjusted address
    mov rdi, [rdi]           // RDI = [RDI]
                             // Dereference at offset 0xC (12 bytes)
    mov eax, [rdi+C]         // EAX = 32-bit value at [RDI + 0xC]
    mov rdi, rax             // Extend to 64-bit and move to RDI
                             // Add module base address
    add rdi, rbx             // RDI = RDI + module base address
                             // Add offset 0x10
    add rdi,10               // RDI = RDI + 0x10
                             // Dereference the final calculated address
    lea rdi,[rdi+8]          // EXTRA
    mov rax,0
    mov eax, [rdi]           // RAX = [RDI], final vtable string address
                             // Restore registers and return
    pop rdi                  // Restore RDI
    pop rbx                  // Restore RBX
    leave                    // Restore RBP and clean up the stack
    ret




