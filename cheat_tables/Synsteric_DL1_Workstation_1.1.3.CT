alloc(AISkinName,64)
registersymbol(AISkinName)
alloc(AIMeshName,64)
registersymbol(AIMeshName)
AIMeshName:
db '',0

AISkinName:
db '',0

alloc(shouldModifyMesh,1)
registersymbol(shouldModifyMesh)


alloc(AIMeshLength,4)
alloc(AISkinLength,4)
label(meshNull)
label(back)
label(meshStringReplace)
label(pops)
label(skipMesh)

alloc(AISkinName_allocation,8)
alloc(AIMeshName_allocation,8)
newmem:
cmp byte ptr [AISkinName],0
je code
cmp byte ptr [AIMeshName],0
je meshNull

back:
push rax
push rcx
push rdx
push r8
push r9
push r11

lea rcx,[AIMeshName]
call ucrtbase.strlen
mov [AIMeshLength],eax

lea rcx,[AISkinName]
call ucrtbase.strlen
mov [AISkinLength],eax



pop r11
pop r9
pop r8
pop rdx
pop rcx
pop rax

// i THINK this should prevent memory leak
push rcx
push rdx
sub rsp,60
reassemble(SetAIMeshAndName)
mov rcx,[rdx]
call ucrtbase.free
add rsp,60
pop rdx
pop rcx


push rdx
push r8
push r9
push r10
push r11
push rcx

sub rsp,60
movsxd rcx, dword ptr [AISkinLength]
inc rcx //prevents ucrtbase.free crash later
call ucrtbase.malloc
add rsp,60
test rax, rax
je code
mov [AISkinName_allocation],rax



pop rcx
pop r11
pop r10
pop r9
pop r8
pop rdx

//cmp [rdx],rax
//je code


cmp byte ptr [shouldModifyMesh],0
je skipMesh



// i THINK this should prevent memory leak
push rcx
push rdx
sub rsp,60
reassemble(SetAIMeshAndName)
mov rcx,[rdx-10]
call ucrtbase.free
add rsp,60
pop rdx
pop rcx








push rdx
push r8
push r9
push r10
push r11
push rcx

sub rsp,60
movsxd rcx, dword ptr [AIMeshLength]
inc rcx //prevents ucrtbase.free crash later
call ucrtbase.malloc
add rsp,60
test rax, rax
je code
mov [AIMeshName_allocation],rax

pop rcx
pop r11
pop r10
pop r9
pop r8
pop rdx

//cmp [rdx-10],rax
//je code




skipMesh:


reassemble(SetAIMeshAndName)
mov ecx,[AISkinLength]
mov [rdx+8],ecx
mov [rdx+c],ecx



push rsi
push rdi

cld
mov ecx,[AISkinLength]
mov rsi,AISkinName
mov rdi,[AISkinName_allocation]
rep movsb

mov rcx,[AISkinName_allocation]
movsxd rax,dword ptr [AISkinLength]
mov byte ptr [rcx+rax],0
mov [rdx],rcx

cmp byte ptr [shouldModifyMesh],1
je meshStringReplace
jmp pops

