  <LuaScript>if syntaxcheck then return end
controlMainForm = getMainForm()
control_setCaption(controlMainForm , "DL1 Cheat Table v. 1.1.3 for 1.53")


function GetClass()
 local script = getAddressList().getMemoryRecordByDescription("Get Classes")
    if script.Active == false then
        script.Active = true
        Sleep(1000)
    end
end

if not readInteger("DyingLightGame.exe") then
    getAutoAttachList().add("DyingLightGame.exe")

end

if enumModules(getCheatEngineProcessID())[1].PathToFile:find('cheatengine%-x86_64%-SSE4%-AVX2.exe') then
  MainForm.Caption=MainForm.Caption.." | SSE4-AVX2 Version"
end



function activateScriptTemporarily(description, duration, autoDisable)
    local entry = getAddressList().getMemoryRecordByDescription(description)
    if entry and not entry.Active then
        entry.Active = true
        if autoDisable == 1 then
            local timer = createTimer(nil, false)
            timer.Interval = duration
            timer.OnTimer = function()
                entry.Active = false
                timer.destroy()
            end
            timer.Enabled = true
        end
    end
end
